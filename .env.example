# Copy this file to .env and fill in real values before running the project.

# MongoDB connection string.
# Local MongoDB:        mongodb://127.0.0.1:27017/brewbean
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brewbean
MONGO_URI=mongodb://127.0.0.1:27017/brewbean

# Any long random string — used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on.
PORT=4000

# Optional first-admin provisioning. Use a unique email and password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Café Admin

# Gmail: create a Google App Password with 2-Step Verification enabled.
# Do not use your regular Gmail password; never commit/share the real .env file.
# SMTP readiness can be checked with `npm run email:check` (does not send mail).
APP_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
